{
  "name": "todo-desktop",
  "productName": "Opensource ToDo",
  "version": "10.0.0",
  "description": "Opensource ToDo - an unofficial, open source Microsoft To-Do desktop app (fork of Kuro, itself a fork of Ao)",
  "license": "MIT",
  "repository": "fildunsky/opensource-todo",
  "author": {
    "name": "Fil Dunsky",
    "email": "openwrtfun@gmail.com",
    "url": "https://github.com/fildunsky"
  },
  "maintainers": [
    {
      "name": "Fil Dunsky",
      "email": "openwrtfun@gmail.com",
      "url": "https://github.com/fildunsky"
    }
  ],
  "contributors": [
    {
      "name": "David Morais",
      "email": "david@davidmorais.com",
      "url": "https://github.com/davidsmorais"
    },
    {
      "name": "Klaus Sinani",
      "email": "klaussinani@gmail.com",
      "url": "https://github.com/klaussinani"
    }
  ],
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "icons": "electron-icon-maker --input=./static/Icon.png --output=./build/",
    "test": "xo && stylelint 'src/style/*.css'",
    "release": "yarn version && rm -rf dist build && yarn icons && electron-builder --publish never",
    "build-snap": "electron-builder --linux snap",
    "build-flatpak": "electron-builder build --linux flatpak",
    "build-win": "electron-builder --win",
    "start": "electron ."
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "conf": "^10.2.0",
    "electron-context-menu": "^3.6.1",
    "electron-debug": "^1.4.0",
    "electron-dl": "^2.0.0",
    "electron-store": "^8.1.0",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^24.13.3",
    "electron-icon-maker": "^0.0.5",
    "stylelint": "^14.9.1",
    "xo": "^0.53.1"
  },
  "xo": {
    "envs": [
      "browser",
      "node"
    ],
    "rules": {
      "n/prefer-global/process": 0,
      "unicorn/prefer-module": 0,
      "unicorn/no-for-loop": 0,
      "unicorn/no-array-for-each": 0,
      "import/extensions": 0,
      "object-curly-spacing": 0,
      "quote-props": 0,
      "unicorn/prefer-query-selector": 0,
      "quotes": [
        "error",
        "double"
      ]
    },
    "space": 2
  },
  "stylelint": {
    "rules": {
      "block-closing-brace-empty-line-before": "never",
      "block-closing-brace-newline-after": "always",
      "block-no-empty": true,
      "block-opening-brace-space-before": "always",
      "color-hex-case": "upper",
      "color-hex-length": "long",
      "color-no-invalid-hex": true,
      "comment-no-empty": true,
      "declaration-block-semicolon-space-before": "never",
      "indentation": 2,
      "max-empty-lines": 0,
      "no-duplicate-selectors": true
    }
  },
  "build": {
    "appId": "com.fildunsky.todo",
    "snap": {
      "title": "Opensource ToDo"
    },
    "files": [
      "**/*",
      "!media${/*}",
      "!docs${/*}"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icons/win/icon.ico",
      "publish": {
        "provider": "github",
        "releaseType": "release"
      }
    },
    "flatpak": {
      "artifactName": "com.fildunsky.todo.${ext}",
      "category": "Office",
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "25.08",
      "sdk": "org.freedesktop.Sdk",
      "finishArgs": [
        "--share=network",
        "--share=ipc",
        "--socket=x11",
        "--socket=wayland",
        "--device=dri",
        "--filesystem=home"
      ]
    },
    "linux": {
      "category": "Office",
      "icon": "icons/png",
      "description": "Opensource ToDo is an unofficial, featureful, open source, community-driven, free Microsoft To-Do app for Linux. A fork of Kuro (David Morais), itself a fork of Ao (Klaus Sinani).",
      "synopsis": "Open source Microsoft To-Do desktop app",
      "publish": {
        "provider": "github",
        "releaseType": "release"
      },
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "snap",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "flatpak",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
